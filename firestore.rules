rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Suspended accounts (banned == true, set by an admin in the Console) cannot like, match or message.
    // Messaging needs a verified email address (the token claim updates after the user verifies).
    function emailVerified() {
      return request.auth.token.email_verified == true;
    }

    // Admins are listed in the `admins` collection (added by hand in the Console, never by the app).
    // Edit the email list below to add or remove admins without touching the Console data.
    function isAdmin() {
      return isSignedIn()
        && (exists(/databases/$(database)/documents/admins/$(request.auth.uid))
            || (request.auth.token.email_verified == true
                && request.auth.token.email in ['smarttechlab.apps@gmail.com', 'loydmawira@gmail.com']));
    }

    function notBanned() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) != true;
    }

    // photoVerified and banned can only be changed by an admin in the Console, never by the app.
    function adminFieldsUnchanged() {
      return request.resource.data.get('photoVerified', false) == resource.data.get('photoVerified', false)
        && request.resource.data.get('banned', false) == resource.data.get('banned', false);
    }

    // ---------- USERS ----------
    match /users/{userId} {
      allow read: if isSignedIn();
      // The verified badge needs a phone number really linked to the account
      // (the phone_number claim only exists after Firebase Phone Auth).
      allow create: if isOwner(userId)
        && request.resource.data.isVip == false
        && request.resource.data.get('photoVerified', false) == false
        && request.resource.data.get('banned', false) == false
        && (request.resource.data.isPhoneVerified == false
            || request.auth.token.phone_number != null);
      allow update: if isOwner(userId)
        && resource.data.get('banned', false) != true
        && adminFieldsUnchanged()
        && request.resource.data.isVip == resource.data.isVip
        && (request.resource.data.isPhoneVerified == false
            || request.auth.token.phone_number != null);
      // An admin can only ever flip the photo-verified badge or suspend / unsuspend someone
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoVerified', 'banned']);
      allow delete: if isOwner(userId);

      match /private/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ---------- SWIPES (likes and passes) ----------
    match /swipes/{swipeId} {
      // reading a swipe that does not exist yet must be allowed (mutual-like check)
      allow get: if isSignedIn()
        && (resource == null
            || resource.data.fromUserId == request.auth.uid
            || resource.data.toUserId == request.auth.uid);
      allow list: if isSignedIn()
        && (resource.data.fromUserId == request.auth.uid
            || resource.data.toUserId == request.auth.uid);
      allow create, update: if isSignedIn()
        && notBanned()
        && request.resource.data.fromUserId == request.auth.uid
        && swipeId == request.auth.uid + '_' + request.resource.data.toUserId;
      allow delete: if isSignedIn() && resource.data.fromUserId == request.auth.uid;
    }

    // ---------- NOTIFICATIONS ----------
    match /notifications/{notifId} {
      allow read, update, delete: if isSignedIn() && resource.data.toUserId == request.auth.uid;
      allow create: if isSignedIn()
        && notBanned()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toUserId != request.auth.uid;
    }

    // ---------- MATCHES ----------
    match /matches/{matchId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.userIds;
      allow create: if isSignedIn()
        && notBanned()
        && request.auth.uid in request.resource.data.userIds
        && request.resource.data.userIds.size() == 2;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.userIds
        && request.resource.data.userIds == resource.data.userIds;
      allow delete: if isSignedIn() && request.auth.uid in resource.data.userIds;
    }

    // ---------- CHATS ----------
    match /chats/{chatId} {
      allow read: if isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/matches/$(resource.data.matchId)).data.userIds;
      allow create: if isSignedIn()
        && notBanned()
        && emailVerified()
        && request.resource.data.senderId == request.auth.uid
        && request.auth.uid in get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.userIds;
      // The receiver may only stamp the message as seen
      allow update: if isSignedIn()
        && resource.data.senderId != request.auth.uid
        && request.auth.uid in get(/databases/$(database)/documents/matches/$(resource.data.matchId)).data.userIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
      // Either person may react with an emoji
      allow update: if isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/matches/$(resource.data.matchId)).data.userIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reaction']);
      allow delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
    }

    // ---------- TYPING INDICATORS (doc id = matchId_userId) ----------
    match /typing/{typingId} {
      allow read: if isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/matches/$(typingId.split('_')[0])).data.userIds;
      allow write: if isSignedIn()
        && typingId.split('_')[1] == request.auth.uid
        && request.auth.uid in get(/databases/$(database)/documents/matches/$(typingId.split('_')[0])).data.userIds;
    }

    // ---------- BLOCKS ----------
    match /blocks/{blockId} {
      allow get: if isSignedIn()
        && (resource == null
            || resource.data.blockerId == request.auth.uid
            || resource.data.blockedId == request.auth.uid);
      allow list: if isSignedIn()
        && (resource.data.blockerId == request.auth.uid
            || resource.data.blockedId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.blockerId == request.auth.uid
        && blockId == request.auth.uid + '_' + request.resource.data.blockedId;
      allow delete: if isSignedIn() && resource.data.blockerId == request.auth.uid;
    }

    // ---------- REPORTS (write-only for users) ----------
    // One report per person (the id is reporter_reported), so reports cannot be spammed.
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && reportId == request.auth.uid + '_' + request.resource.data.reportedId;
    }

    // ---------- PHOTO VERIFICATION REQUESTS (selfie, reviewed by an admin in the Console) ----------
    match /verificationRequests/{requestId} {
      allow read: if isOwner(requestId) || isAdmin();
      allow delete: if isOwner(requestId) || isAdmin();
      allow create: if isOwner(requestId)
        && notBanned()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      // Only an admin can decide a request
      allow update: if isAdmin()
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.uid == resource.data.uid;
    }

    // Who is an admin (each person can only check their own entry; entries are added in the Console)
    match /admins/{adminId} {
      allow get: if isOwner(adminId);
    }

    // Audit trail of every approve / reject decision (append-only, admins only)
    match /verificationAudit/{auditId} {
      allow create: if isAdmin() && request.resource.data.adminId == request.auth.uid;
      allow read: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
