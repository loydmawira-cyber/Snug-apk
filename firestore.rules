rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isOwner(userId);
    }

    match /matches/{matchId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.userIds;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.userIds;
      allow update: if isSignedIn() && request.auth.uid in resource.data.userIds;
    }

    match /chats/{chatId} {
      allow read: if isSignedIn(); // In a real app, we'd check if user is part of the match
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.senderId;
    }
  }
}
